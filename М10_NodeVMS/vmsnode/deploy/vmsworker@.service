# The worker: DriverPack with N cameras. `systemctl start vmsworker@w-1` — the
# instance name is the worker's stable identity. On one box, one instance;
# in М11 this unit becomes a Nomad service job with count = N.
[Unit]
Description=VMS worker %i — pipelines against its assignment
After=network.target

[Service]
Environment=PLATFORM_DIR=/data/platform SPOOL=/data/spool ARCHIVE=/data/archive MEDIA_DIR=/data/media WORKER_NAME=%i
WorkingDirectory=/opt/vmsnode
ExecStart=/usr/bin/python3 -m vms worker
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
