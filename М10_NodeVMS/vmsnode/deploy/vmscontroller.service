# The controller: one per box (one per cluster in М11). Stateless — restart it freely.
[Unit]
Description=VMS controller — the only writer of vms/*
After=network.target

[Service]
Environment=PLATFORM_DIR=/data/platform SPOOL=/data/spool ARCHIVE=/data/archive CONSOLE_PORT=8080 CAPACITY=50
WorkingDirectory=/opt/vmsnode
ExecStart=/usr/bin/python3 -m vms controller
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
