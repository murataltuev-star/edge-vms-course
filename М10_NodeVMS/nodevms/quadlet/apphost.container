# /etc/containers/systemd/apphost.container — Lessons 21–24.
# One process: reconcile, pump_buses, report, retention, console.
# Ordering is expressed in unit dependencies, not with sleep (Lesson 20).
[Unit]
Description=NodeVMS AppHost
Requires=postgres.service
After=postgres.service

[Container]
Image=localhost/nodevms-apphost:latest
Volume=/data/archive:/data/archive:z
Volume=/data/config:/data/config:ro,z
EnvironmentFile=/data/config/apphost.env
Network=host
# SIGTERM lets every splitmuxsink finalize its open segment; the kill test
# in Lesson 23 uses SIGKILL on purpose and loses exactly that segment.
StopTimeout=20

[Service]
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
