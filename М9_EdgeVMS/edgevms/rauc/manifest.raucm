# Lesson 2, Step 4 — template; build-bundle.sh fills in the version.
[update]
compatible=example-vms-appliance-x86-64
version=@VERSION@

[bundle]
# verity: a dm-verity hash tree over the payload, verified block by block as
# it is read; also what makes installing from an HTTP URL possible.
format=verity

[image.rootfs]
filename=rootfs.ext4
# No sha256, no size: rauc bundle computes and writes them.
