# /etc/containers/systemd/spool-uploader.container — Lesson 19, Step 6.
# The uploader is a SEPARATE process from capture: delete on acknowledgement
# needs somebody other than the writer to do the deleting. Runs the same image
# as the agent with a different entrypoint, so there is one thing to publish.
[Unit]
Description=Spool uploader (delete on acknowledgement)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/example/vms-agent:1.0
EnvironmentFile=/data/config/agent.env
Volume=/data/spool:/data/spool:z
Volume=/run/vms:/run/vms:z
# Lesson 16's number: cameras x bitrate x outage. 8 x 4 Mbit/s x 24 h ~ 346 GB.
Exec=python3 /app/spool.py --root /data/spool --max-bytes 345600000000 \
     --policy drop-oldest --budget 2 --tick 5 --upload-cmd "vms-upload-segment"

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
