# deploy/Containerfile — localhost/clustervms-apphost:latest
# Build from the COURSE ROOT: М10's nodevms plus this package.
#   podman build -f М11_ClusterVMS/clustervms/deploy/Containerfile -t localhost/clustervms-apphost:latest .
FROM docker.io/library/debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-gi \
        gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad \
        gir1.2-gst-plugins-base-1.0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN pip3 install --break-system-packages --no-cache-dir asyncpg fastapi uvicorn argon2-cffi cryptography
COPY М10_NodeVMS/nodevms nodevms
COPY М11_ClusterVMS/clustervms/cluster cluster
ENV NODEVMS_PATH=/app/nodevms
CMD ["python3", "-m", "cluster"]
