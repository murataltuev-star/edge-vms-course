# docker/vms-agent/Containerfile — the image М9's appliance runs:
#   localhost/example/vms-agent:1.0   (edgevms/quadlet/vms-agent.container)
#
# Build from the COURSE ROOT so it can take М8's server+edge and М9's spool:
#   podman build -f М8_KVS_VMS/kvsvms/docker/vms-agent/Containerfile -t localhost/example/vms-agent:1.0 .
#
# Layers: the kvssink image (Lesson 8, built once, 20–40 min) + python +
# the server, the edge supervisor, the uploader and the spool.
ARG KVSSINK_IMAGE=kvs-vms-mvp/kvssink
FROM ${KVSSINK_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY М8_KVS_VMS/kvsvms/server/requirements.txt server/requirements.txt
COPY М8_KVS_VMS/kvsvms/edge/requirements.txt   edge/requirements.txt
RUN pip3 install --no-cache-dir -r server/requirements.txt -r edge/requirements.txt
COPY М8_KVS_VMS/kvsvms/server server
COPY М8_KVS_VMS/kvsvms/edge   edge
COPY М8_KVS_VMS/kvsvms/web    web
COPY М9_EdgeVMS/edgevms/spool/spool.py spool.py
# The acknowledged uploader, by the name edgevms/spool/spool.py's
# --upload-cmd and edgevms/quadlet/spool-uploader.container use.
RUN printf '#!/bin/sh\nexec python3 /app/edge/upload_segment.py "$@"\n' > /usr/local/bin/vms-upload-segment \
    && chmod +x /usr/local/bin/vms-upload-segment
ENV PYTHONUNBUFFERED=1
# Not gst-launch: the agent is the server (Lesson 13), which supervises the
# pipeline through recording.py -> edge/looper.py.
ENTRYPOINT []
CMD ["python3", "-m", "uvicorn", "server.app:app", "--host", "0.0.0.0", "--port", "8000"]
