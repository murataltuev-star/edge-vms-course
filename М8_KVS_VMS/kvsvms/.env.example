# .env.example — commit this; copy to .env and fill in (Lesson 6, Step 2)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...        # only for temporary credentials (SSO / assumed role)
KVS_STREAM_NAME=cam-01
KVS_RETENTION_HOURS=24
CLIP_PATH=./media/clip.mp4
# KVS_DOCKER_IMAGE=kvs-vms-mvp/kvssink   # empty = run kvssink on the host
SERVER_PORT=8000
TIMELINE_WINDOW_MINUTES=60      # duplicated in web/app.js — no config endpoint, on purpose
PLAYBACK_CHUNK_SECONDS=300      # duplicated in web/app.js

# М9 Lesson 4 — set on the appliance only. Empty = М8 behaviour (kvssink direct).
